                "const": "update_section"
              },
              "scene_id": {
                "type": "string"
              },
              "section": {
                "$ref": "#/$defs/Section"
              }
            },
            "additionalProperties": false,
            "required": [
              "operation",
              "scene_id",
              "section"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "remove_section"
              },
              "scene_id": {
                "type": "string"
              },
              "section_id": {
                "type": "string"
