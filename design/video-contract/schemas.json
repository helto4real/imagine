              "$ref": "#/$defs/SettingsSlot"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Section"
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Binding"
            }
          },
          "continuity": {
            "anyOf": [
              {
                "$ref": "#/$defs/Continuity"
              },
              {
                "type": "null"
              }
