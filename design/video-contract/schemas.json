            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "fps",
          "width",
          "height"
        ]
      },
      "Time": {
        "description": "Exact, nonnegative timeline time. Validation belongs to the document boundary.",
        "type": "object",
