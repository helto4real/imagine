            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "den": {
            "type": "integer",
            "format": "uint64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "required": [
          "num",
          "den"
        ]
      },
      "Asset": {
        "type": "object",
