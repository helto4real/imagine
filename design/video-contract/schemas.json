{
  "create_project": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CreateProject",
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "integer",
        "format": "uint32",
        "minimum": 1,
        "maximum": 1
      },
      "default_model": {
        "$ref": "#/$defs/ModelSelection"
      },
      "delivery": {
        "$ref": "#/$defs/DeliverySettings"
      }
    },
    "additionalProperties": false,
    "required": [
      "schema_version",
      "default_model",
      "delivery"
    ],
    "$defs": {
      "ModelSelection": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "profile_revision": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "adapter",
          "model",
          "variant",
          "profile",
          "profile_revision"
        ]
      },
      "DeliverySettings": {
        "type": "object",
        "properties": {
          "fps": {
            "$ref": "#/$defs/Time"
          },
          "width": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "fps",
          "width",
          "height"
        ]
      },
      "Time": {
        "description": "Exact, nonnegative timeline time. Validation belongs to the document boundary.",
        "type": "object",
        "properties": {
          "num": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "den": {
            "type": "integer",
            "format": "uint64",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "required": [
          "num",
          "den"
        ]
      }
    }
  },
  "edit_request": {
