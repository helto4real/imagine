              },
              "scene_id": {
                "type": "string"
              },
              "settings": {
                "$ref": "#/$defs/SettingsSlot"
              }
            },
            "additionalProperties": false,
            "required": [
              "operation",
              "scene_id",
              "settings"
            ]
          },
          {
            "type": "object",
