          "method": {
            "$ref": "#/$defs/ContinuityMethod"
          }
        },
        "additionalProperties": false,
        "required": [
          "source_scene",
          "method"
        ]
      },
      "ContinuityMethod": {
        "type": "string",
        "enum": [
          "last_frame_first_frame",
          "combo",
          "influence",
          "motion_context",
          "motion_context_exp"
        ]
      },
      "AcceptedTake": {
        "description": "A retained source identity; complete result/provenance publication belongs to P03.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "$ref": "#/$defs/ModelSelection"
          },
          "source_fingerprint": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "model",
          "source_fingerprint"
        ]
      }
    }
  },
  "capabilities": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Capabilities",
    "type": "object",
    "properties": {
      "revision": {
        "type": "string"
      },
      "runtime_available": {
        "type": "boolean"
      },
      "experimental": {
        "type": "boolean"
      },
      "validation_status": {
        "$ref": "#/$defs/ValidationStatus"
      },
      "input_roles": {
        "type": "object",
        "properties": {
          "audio_reference": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          },
          "first_frame": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          },
          "last_frame": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          },
          "video_reference": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          },
          "visual_reference": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          },
          "voice_reference": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/MediaKind"
            }
          }
        },
        "additionalProperties": false
      },
      "continuity": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/ContinuityMethod"
        }
      },
      "incompatible_roles": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/InputRole"
            },
            {
              "$ref": "#/$defs/InputRole"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "revision",
      "runtime_available",
      "experimental",
      "validation_status",
      "input_roles",
      "continuity",
      "incompatible_roles"
    ],
    "$defs": {
      "ValidationStatus": {
        "type": "string",
        "enum": [
          "unvalidated",
          "synthetic_verified",
          "runtime_verified"
        ]
      },
      "MediaKind": {
        "type": "string",
        "enum": [
          "image",
          "video",
          "audio"
        ]
      },
      "ContinuityMethod": {
        "type": "string",
        "enum": [
          "last_frame_first_frame",
          "combo",
          "influence",
          "motion_context",
          "motion_context_exp"
        ]
      },
      "InputRole": {
        "type": "string",
        "enum": [
          "first_frame",
          "last_frame",
          "visual_reference",
          "video_reference",
          "voice_reference",
          "audio_reference"
        ]
      }
    }
  },
  "h3_settings": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "H3Settings",
    "description": "No image CFG/negative-conditioning defaults. Exact runtime constraints belong to P05.",
    "type": "object",
    "properties": {
      "stage_one": {
        "$ref": "#/$defs/H3Stage"
      },
      "stage_two": {
        "anyOf": [
          {
            "$ref": "#/$defs/H3SecondStage"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "stage_one"
    ],
    "$defs": {
      "H3Stage": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "sampler": {
            "type": "string"
          },
          "scheduler": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "steps",
          "sampler",
          "scheduler"
        ]
      },
      "H3SecondStage": {
        "type": "object",
        "properties": {
          "sampling": {
            "$ref": "#/$defs/H3Stage"
          },
          "model": {
            "$ref": "#/$defs/ModelSelection"
          },
          "handoff": {
            "$ref": "#/$defs/H3Handoff"
          },
          "trained_latent_upscale_model": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "sampling",
          "model",
          "handoff"
        ]
      },
      "ModelSelection": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "profile_revision": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "adapter",
          "model",
          "variant",
          "profile",
          "profile_revision"
        ]
      },
      "H3Handoff": {
        "type": "string",
        "enum": [
          "continue_latent",
          "re_noise_video_prediction"
        ]
      }
    }
  },
  "validation_report": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ValidationReport",
    "type": "object",
    "properties": {
      "input_revision": {
        "type": "string"
      },
      "model": {
        "$ref": "#/$defs/ModelSelection"
      },
      "capability_revision": {
        "type": [
          "string",
          "null"
        ]
      },
      "runtime_available": {
        "type": "boolean"
      },
      "blockers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Issue"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "input_revision",
      "model",
      "runtime_available",
      "blockers"
    ],
    "$defs": {
      "ModelSelection": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "profile_revision": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "adapter",
          "model",
          "variant",
          "profile",
          "profile_revision"
        ]
      },
      "Issue": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "scene_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "field"
        ]
      }
    }
  }
}
