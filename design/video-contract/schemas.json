        "required": [
          "id",
          "start",
          "duration",
          "description",
          "model",
          "settings",
          "sections",
          "bindings"
        ]
      },
      "ModelChoice": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "project_default"
            ]
          },
          {
            "type": "object",
            "properties": {
              "override": {
                "$ref": "#/$defs/ModelSelection"
              }
            },
            "required": [
              "override"
            ],
            "additionalProperties": false
          }
        ]
      },
      "SettingsSlot": {
        "description": "Settings are keyed by the entire model/profile identity, never copied between models.",
        "type": "object",
        "properties": {
          "model": {
            "$ref": "#/$defs/ModelSelection"
          },
          "schema_version": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "values": true
        },
        "additionalProperties": false,
        "required": [
          "model",
          "schema_version",
          "values"
        ]
      },
      "Section": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "$ref": "#/$defs/Time"
          },
          "duration": {
            "$ref": "#/$defs/Time"
          },
          "prompt": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "start",
          "duration",
          "prompt"
        ]
      },
      "Binding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "role": {
            "$ref": "#/$defs/InputRole"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "asset",
          "role",
          "enabled"
        ]
      },
      "InputRole": {
        "type": "string",
        "enum": [
          "first_frame",
          "last_frame",
          "visual_reference",
          "video_reference",
          "voice_reference",
          "audio_reference"
        ]
      },
      "Continuity": {
        "type": "object",
        "properties": {
          "source_scene": {
            "type": "string"
          },
          "method": {
            "$ref": "#/$defs/ContinuityMethod"
          }
        },
        "additionalProperties": false,
        "required": [
          "source_scene",
          "method"
        ]
      },
      "ContinuityMethod": {
        "type": "string",
        "enum": [
          "last_frame_first_frame",
          "combo",
          "influence",
          "motion_context",
          "motion_context_exp"
        ]
      },
      "AcceptedTake": {
        "description": "A retained source identity; complete result/provenance publication belongs to P03.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "$ref": "#/$defs/ModelSelection"
          },
          "source_fingerprint": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "model",
          "source_fingerprint"
        ]
      }
    }
  },
