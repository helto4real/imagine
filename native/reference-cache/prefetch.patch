+#include "core/cache_prefetch.h"
+
+#include <algorithm>
+#include <unordered_set>
+
+#include "core/ggml_extend_backend.h"
+#include "core/ggml_graph_cut.h"
+#include "core/util.h"
+
+namespace sd {
+    CachePrefetch::~CachePrefetch() {
+        clear();
+    }
+
+    void CachePrefetch::add_input(ggml_tensor* target, ggml_tensor* source) {
+        GGML_ASSERT(!active_ && source != nullptr && ggml_is_contiguous(source));
+        inputs_[target] = source;
+    }
+
+    size_t CachePrefetch::bytes() const {
+        size_t size = 0;
+        for (const auto& slot : slots_) {
+            if (slot.buffer != nullptr) {
+                size += ggml_backend_buffer_get_size(slot.buffer);
+            }
+        }
+        return size;
+    }
+
+    bool CachePrefetch::prepare(ggml_cgraph* graph, const ggml_graph_cut::Plan& plan, const std::function<bool(size_t)>& admit) {
+        GGML_ASSERT(!active_);
+        if (inputs_.empty() || !sd_backend_is(compute_, "CUDA")) {
+            return false;
+        }
+        auto device = ggml_backend_get_device(compute_);
+        ggml_backend_dev_props props{};
+        ggml_backend_dev_get_props(device, &props);
+        if (!props.caps.async || !props.caps.events) {
+            return false;
+        }
+        auto buft              = ggml_backend_get_default_buffer_type(compute_);
+        const size_t alignment = ggml_backend_buft_get_alignment(buft);
+        size_t peak = 0, group_count = 0;
+        std::unordered_set<ggml_tensor*> seen;
+        groups_.resize(plan.segments.size());
+        for (size_t i = 0; i < plan.segments.size(); ++i) {
+            auto& group   = groups_[i];
+            size_t offset = 0;
+            for (const auto& ref : plan.segments[i].input_refs) {
+                auto target = ggml_graph_cut::input_tensor(graph, ref);
+                auto input  = inputs_.find(target);
+                if (input == inputs_.end()) {
+                    continue;
+                }
+                // A staging alias may only live within one segment.
+                if (!seen.insert(target).second) {
+                    return false;
+                }
+                group.inputs.push_back({target, input->second, offset});
+                const size_t size = GGML_PAD(ggml_backend_buft_get_alloc_size(buft, target), alignment);
+                if (size > SIZE_MAX - offset) {
+                    return false;
+                }
+                offset += size;
+            }
+            if (!group.inputs.empty()) {
+                group.slot = group_count++ % slots_.size();
+                peak       = std::max(peak, offset);
+            }
+        }
+        if (seen.size() != inputs_.size() || peak == 0 || peak > SIZE_MAX / slots_.size()) {
+            return false;
+        }
+        if (transfer_ == nullptr) {
+            transfer_ = ggml_backend_dev_init(device, nullptr);
+            if (transfer_ == nullptr) {
+                return false;
+            }
+            for (auto& slot : slots_) {
+                slot.ready    = ggml_backend_event_new(device);
+                slot.consumed = ggml_backend_event_new(device);
+                if (slot.ready == nullptr || slot.consumed == nullptr) {
+                    clear();
+                    return false;
+                }
+            }
+        }
+        const bool grows = std::any_of(slots_.begin(), slots_.end(), [&](const Slot& slot) {
+            return slot.buffer == nullptr || ggml_backend_buffer_get_size(slot.buffer) < peak;
+        });
+        if (grows) {
+            // No graph is active at resize; finish both streams before releasing aliases.
+            ggml_backend_synchronize(compute_);
+            ggml_backend_synchronize(transfer_);
+            for (auto& slot : slots_) {
+                ggml_backend_buffer_free(slot.buffer);
+                slot.buffer = nullptr;
+            }
+            if (!admit(peak * slots_.size())) {
+                return false;
+            }
+            for (auto& slot : slots_) {
+                slot.buffer = ggml_backend_alloc_buffer(compute_, peak);
+                if (slot.buffer == nullptr) {
+                    clear();
+                    return false;
+                }
+            }
+        }
+        for (auto& group : groups_) {
+            auto& slot = slots_[group.slot];
+            for (auto& input : group.inputs) {
+                const auto address = static_cast<char*>(ggml_backend_buffer_get_base(slot.buffer)) + input.offset;
+                if (ggml_backend_tensor_alloc(slot.buffer, input.target, address) != GGML_STATUS_SUCCESS) {
+                    clear();
+                    return false;
+                }
+            }
+        }
+        active_ = true;
+        return true;
+    }
+
+    void CachePrefetch::enqueue(size_t index) {
+        auto& group = groups_[index];
+        if (group.inputs.empty() || group.queued) {
+            return;
+        }
+        auto& slot = slots_[group.slot];
+        if (slot.used) {
+            ggml_backend_event_wait(transfer_, slot.consumed);
+        }
+        for (const auto& input : group.inputs) {
+            ggml_backend_tensor_set_async(transfer_, input.target, input.source->data, 0, ggml_nbytes(input.source));
+            transferred_bytes_ += ggml_nbytes(input.source);
+        }
+        ggml_backend_event_record(slot.ready, transfer_);
+        group.queued = true;
+        ++queued_groups_;
+    }
+
+    void CachePrefetch::before_segment(size_t index) {
+        if (!active_) {
+            return;
+        }
+        auto& group = groups_[index];
+        if (!group.inputs.empty()) {
+            enqueue(index);
+            ggml_backend_event_wait(compute_, slots_[group.slot].ready);
+        }
+        for (size_t next = index + 1; next < groups_.size(); ++next) {
+            if (!groups_[next].inputs.empty()) {
+                enqueue(next);
+                break;
+            }
+        }
+    }
+
+    void CachePrefetch::after_segment(size_t index) {
+        if (active_ && !groups_[index].inputs.empty()) {
+            auto& slot = slots_[groups_[index].slot];
+            ggml_backend_event_record(slot.consumed, compute_);
+            slot.used = true;
+        }
+    }
+
+    void CachePrefetch::graph_end() {
+        if (transfer_ != nullptr) {
+            // A failed/cancelled forward may leave the next host copy in flight.
+            ggml_backend_synchronize(compute_);
+            ggml_backend_synchronize(transfer_);
+        }
+        if (active_) {
+            LOG_DEBUG("reference cache prefetch: %zu groups, %.2f MiB copied, %.2f MiB staging",
+                      queued_groups_, transferred_bytes_ / (1024.0 * 1024.0), bytes() / (1024.0 * 1024.0));
+        }
+        for (const auto& input : inputs_) {
+            for (const auto& slot : slots_) {
+                if (slot.buffer != nullptr && input.first->buffer == slot.buffer) {
+                    input.first->buffer = nullptr;
+                    input.first->data   = nullptr;
+                    input.first->extra  = nullptr;
+                }
+            }
+        }
+        for (auto& slot : slots_) {
+            slot.used = false;
+        }
+        inputs_.clear();
+        groups_.clear();
+        active_            = false;
+        transferred_bytes_ = queued_groups_ = 0;
+    }
+
+    void CachePrefetch::clear() {
+        graph_end();
+        for (auto& slot : slots_) {
+            ggml_backend_buffer_free(slot.buffer);
+            ggml_backend_event_free(slot.ready);
+            ggml_backend_event_free(slot.consumed);
+            slot = {};
+        }
+        ggml_backend_free(transfer_);
+        transfer_ = nullptr;
+    }
+}
