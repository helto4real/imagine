+#ifndef __SD_CORE_CACHE_PREFETCH_H__
+#define __SD_CORE_CACHE_PREFETCH_H__
+
+#include <array>
+#include <functional>
+#include <map>
+#include <vector>
+
+#include "ggml-backend.h"
+
+namespace sd::ggml_graph_cut {
+    struct Plan;
+}
+
+namespace sd {
+    class CachePrefetch {
+        struct Slot {
+            ggml_backend_buffer_t buffer  = nullptr;
+            ggml_backend_event_t ready    = nullptr;
+            ggml_backend_event_t consumed = nullptr;
+            bool used                     = false;
+        };
+        struct Input {
+            ggml_tensor* target;
+            ggml_tensor* source;
+            size_t offset;
+        };
+        struct Group {
+            std::vector<Input> inputs;
+            size_t slot = 0;
+            bool queued = false;
+        };
+        ggml_backend_t compute_;
+        ggml_backend_t transfer_ = nullptr;
+        std::array<Slot, 2> slots_;
+        std::map<ggml_tensor*, ggml_tensor*> inputs_;
+        std::vector<Group> groups_;
+        bool active_              = false;
+        size_t transferred_bytes_ = 0;
+        size_t queued_groups_     = 0;
+
+        void enqueue(size_t index);
+
+    public:
+        explicit CachePrefetch(ggml_backend_t compute) : compute_(compute) {}
+        ~CachePrefetch();
+        CachePrefetch(const CachePrefetch&)            = delete;
+        CachePrefetch& operator=(const CachePrefetch&) = delete;
+
+        void add_input(ggml_tensor* target, ggml_tensor* source);
+        bool empty() const { return inputs_.empty(); }
+        bool contains(ggml_tensor* tensor) const { return active_ && inputs_.count(tensor); }
+        size_t bytes() const;
+        bool prepare(ggml_cgraph* graph, const ggml_graph_cut::Plan& plan, const std::function<bool(size_t)>& admit);
+        void before_segment(size_t index);
+        void after_segment(size_t index);
+        void graph_end();
+        void clear();
+    };
+}
+
+#endif  // __SD_CORE_CACHE_PREFETCH_H__
