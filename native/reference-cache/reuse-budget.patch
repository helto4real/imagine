+    size_t RunnerCache::host_gpu_bytes() const {
+        size_t bytes = 0;
+        for (const auto& entry : committed_) {
+            if (ggml_backend_buffer_is_host(entry.second->buffer)) {
+                const size_t size = cache_allocation_bytes(backend_, entry.second->tensor);
+                bytes             = size > SIZE_MAX - bytes ? SIZE_MAX : bytes + size;
+            }
+        }
+        return bytes;
