+size_t GGMLRunner::hybrid_segment_workspace(ggml_cgraph* graph, const sd::ggml_graph_cut::Plan& plan, size_t staging_bytes) const {
+    auto buft             = ggml_backend_get_default_buffer_type(runtime_backend);
+    auto allocation_bytes = [&](ggml_tensor* tensor) {
+        return GGML_PAD(ggml_backend_buft_get_alloc_size(buft, tensor),
+                        ggml_backend_buft_get_alignment(buft));
+    };
+    std::map<std::string, size_t> cut_sizes;
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto tensor = ggml_graph_node(graph, i);
+        if (ggml_graph_cut::is_graph_cut_tensor(tensor)) {
+            cut_sizes[tensor->name] = allocation_bytes(ggml_graph_cut::cache_source_tensor(tensor));
+        }
+    }
+    size_t peak = 0;
+    std::unordered_set<std::string> produced;
+    for (const auto& segment : plan.segments) {
+        size_t bytes = add_bytes(segment.compute_buffer_size, staging_bytes);
+        for (const auto& name : produced) {
+            if (segment.live_cut_names.count(name)) {
+                bytes = add_bytes(bytes, cut_sizes.at(name));
+            }
+        }
+        // future_cut_names also names outputs of later segments;
+        // only already produced and current outputs occupy memory.
+        for (int index : segment.output_node_indices) {
+            auto tensor = ggml_graph_node(graph, index);
+            if (ggml_graph_cut::is_graph_cut_tensor(tensor) &&
+                segment.future_cut_names.count(tensor->name) && produced.insert(tensor->name).second) {
+                bytes = add_bytes(bytes, cut_sizes.at(tensor->name));
+            }
+        }
+        peak = std::max(peak, bytes);
+    }
+    return peak;
+}
