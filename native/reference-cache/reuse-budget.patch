+    CachedTensors RunnerCache::promote_host_cache() {
+        GGML_ASSERT(hybrid_storage() && pending_.empty() && outputs_.empty());
+        CachedTensors replacements, retired;
+        for (const auto& entry : committed_) {
+            if (ggml_backend_buffer_is_host(entry.second->buffer)) {
+                ggml_status status;
+                auto copy = CachedTensor::copy(backend_, entry.first, entry.second->tensor, status);
+                if (copy == nullptr) {
+                    return {};  // Keep every original entry if any allocation/copy fails.
+                }
+                replacements[entry.first] = std::move(copy);
+            }
+        }
+        ggml_backend_synchronize(backend_);
+        for (auto& entry : replacements) {
+            retired[entry.first]    = std::move(committed_.at(entry.first));
+            committed_[entry.first] = std::move(entry.second);
+        }
