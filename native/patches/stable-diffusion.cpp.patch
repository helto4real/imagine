+bool sd_backend_graph_pool_memory(ggml_backend_t backend, ggml_cgraph* graph,
+                                  size_t* resident, size_t* growth) {
+    *resident = *growth = 0;
+    if (backend == nullptr || graph == nullptr) {
+        return false;
+    }
+    auto device = ggml_backend_get_device(backend);
+    if (device == nullptr) {
+        return false;
+    }
+    auto reg = ggml_backend_dev_backend_reg(device);
+    using Query = bool (*)(ggml_backend_t, ggml_cgraph*, size_t*, size_t*);
+    auto query = reinterpret_cast<Query>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_graph_pool_memory"));
+    return query != nullptr && query(backend, graph, resident, growth);
+}
