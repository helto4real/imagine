+          {{{{}, {input_scales, 1.0f, {}}, {}}, {static_cast<const float *>(mat->src[2]->data), 1.0f, {}}, {}},
+           {static_cast<const float *>(mul->src[1]->data), 1.0f, {}}, {}}, {} },
+        {static_cast<cutlass::bfloat16_t *>(out->data), {n, cute::_1{}, cute::_0{}}}};
+    DownResidual::Gemm::Arguments args{
+        cutlass::gemm::GemmUniversalMode::kGemm, {(int)rows, (int)n, (int)k}, 1,
+        epilogue, input, weights, nullptr, out->data,
+        0, 0, 0, 0, k, k, n, n};
+    DownResidual::Gemm gemm;
+    if (gemm.can_implement(args) != cutlass::Status::kSuccess) return false;
+    GGML_ASSERT(gemm.get_workspace_size(args) == 0);
