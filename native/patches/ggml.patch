+
+template <int block_size>
+static __global__ void norm_mul_f32(
+        const float * x, const float * mul, float * dst, const int ncols, const int64_t stride_row, const int64_t stride_channel,
+        const int64_t stride_sample, const float eps) {
+    const int nrows     = gridDim.x;
+    const int nchannels = gridDim.y;
+
+    const int row       = blockIdx.x;
+    const int channel   = blockIdx.y;
+    const int sample    = blockIdx.z;
+    const int tid       = threadIdx.x;
+
+    x   += sample*stride_sample + channel*stride_channel + row*stride_row;
+    dst += ((sample*nchannels + channel)*nrows + row)*ncols;
+
+    float2 mean_var = make_float2(0.0f, 0.0f);
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = x[col];
+        mean_var.x += xi;
+        mean_var.y += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float2 s_sum2[];
+    mean_var = block_reduce<block_reduce_method::SUM, block_size>(mean_var, s_sum2);
+
+    const float mean = mean_var.x / ncols;
+    const float var = mean_var.y / ncols - mean * mean;
+    const float inv_std = rsqrtf(var + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = __fmul_rn(__fmul_rn(x[col] - mean, inv_std), mul[col]);
+    }
+}
+
+
+static __global__ void gated_residual_f32(const float * x, const float * gate,
+                                         const float * residual, float * dst, const int64_t size) {
+    const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < size) {
+        dst[i] = __fadd_rn(residual[i], __fmul_rn(x[i], gate[i % 4096]));
+    }
+}
+
+static bool modulation_input(const ggml_tensor * x, const ggml_tensor * row, const ggml_tensor * dst) {
+    return x && row && dst && x->type == GGML_TYPE_F32 && row->type == GGML_TYPE_F32 &&
+           dst->type == GGML_TYPE_F32 && x->ne[0] == 4096 && ggml_nelements(row) == 4096 &&
+           row->ne[0] == 4096 && ggml_is_contiguous(x) && ggml_is_contiguous(row) &&
+           ggml_is_contiguous(dst) && ggml_are_same_shape(x, dst);
+}
+
+static bool modulation_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    const uintptr_t begin_a = reinterpret_cast<uintptr_t>(a->data);
+    const uintptr_t begin_b = reinterpret_cast<uintptr_t>(b->data);
+    return begin_a + ggml_nbytes(a) <= begin_b || begin_b + ggml_nbytes(b) <= begin_a;
+}
+
+bool ggml_cuda_can_fuse_norm_mul(const ggml_tensor * norm, const ggml_tensor * mul) {
+    if (!norm || !mul || norm->op != GGML_OP_NORM || mul->op != GGML_OP_MUL || mul->src[0] != norm ||
+        !modulation_input(norm->src[0], mul->src[1], mul)) {
+        return false;
+    }
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(eps));
+    return eps >= 0.0f && modulation_disjoint(norm->src[0], mul) && modulation_disjoint(mul->src[1], mul);
+}
+
+void ggml_cuda_op_norm_mul(ggml_backend_cuda_context & ctx, const ggml_tensor * norm, ggml_tensor * mul) {
+    const ggml_tensor * x = norm->src[0];
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(eps));
+    norm_mul_f32<1024><<<dim3(x->ne[1], x->ne[2], x->ne[3]), 1024, 32 * sizeof(float2), ctx.stream()>>>(
+        (const float *) x->data, (const float *) mul->src[1]->data, (float *) mul->data,
+        x->ne[0], x->nb[1] / sizeof(float), x->nb[2] / sizeof(float), x->nb[3] / sizeof(float), eps);
+}
+
+bool ggml_cuda_can_fuse_gated_residual(const ggml_tensor * mul, const ggml_tensor * add) {
+    if (!mul || !add || mul->op != GGML_OP_MUL || add->op != GGML_OP_ADD || add->src[1] != mul ||
+        !modulation_input(mul->src[0], mul->src[1], add) ||
+        add->src[0]->type != GGML_TYPE_F32 || !ggml_are_same_shape(add->src[0], add) ||
+        !ggml_is_contiguous(add->src[0])) {
+        return false;
+    }
+    return modulation_disjoint(mul->src[0], add) && modulation_disjoint(mul->src[1], add) &&
+           modulation_disjoint(add->src[0], add);
+}
+
+void ggml_cuda_op_gated_residual(ggml_backend_cuda_context & ctx, const ggml_tensor * mul, ggml_tensor * add) {
+    const int64_t size = ggml_nelements(add);
+    gated_residual_f32<<<(size + 255) / 256, 256, 0, ctx.stream()>>>(
+        (const float *) mul->src[0]->data, (const float *) mul->src[1]->data,
+        (const float *) add->src[0]->data, (float *) add->data, size);
+}
+
+template <int block_size>
+static __global__ void norm_mul_bf16(
+        const nv_bfloat16 * x, const float * mul, float * dst, const int ncols, const int64_t stride_row, const int64_t stride_channel,
+        const int64_t stride_sample, const float eps) {
+    const int nrows     = gridDim.x;
+    const int nchannels = gridDim.y;
+
+    const int row       = blockIdx.x;
+    const int channel   = blockIdx.y;
+    const int sample    = blockIdx.z;
+    const int tid       = threadIdx.x;
+
+    x   += sample*stride_sample + channel*stride_channel + row*stride_row;
+    dst += ((sample*nchannels + channel)*nrows + row)*ncols;
+
+    float2 mean_var = make_float2(0.0f, 0.0f);
+
+    ggml_cuda_pdl_sync();
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = __bfloat162float(x[col]);
+        mean_var.x += xi;
+        mean_var.y += xi * xi;
+    }
+
+    // sum up partial sums
+    extern __shared__ float2 s_sum2[];
+    mean_var = block_reduce<block_reduce_method::SUM, block_size>(mean_var, s_sum2);
+
+    const float mean = mean_var.x / ncols;
+    const float var = mean_var.y / ncols - mean * mean;
+    const float inv_std = rsqrtf(var + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = __fmul_rn(__fmul_rn(__bfloat162float(x[col]) - mean, inv_std), mul[col]);
+    }
+}
+
+
+
+static __global__ void gated_residual_bf16(const float * x, const float * gate,
+                                          const nv_bfloat16 * residual, nv_bfloat16 * dst, const int64_t size) {
+    const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < size) {
+        dst[i] = __float2bfloat16_rn(__fadd_rn(__bfloat162float(residual[i]), __fmul_rn(x[i], gate[i % 4096])));
+    }
+}
+
+bool ggml_cuda_can_fuse_bf16_norm_mul(const ggml_tensor * cast, const ggml_tensor * norm, const ggml_tensor * mul) {
+    if (!cast || !norm || !mul || cast->op != GGML_OP_CPY || cast->src[1] != cast ||
+        cast->type != GGML_TYPE_F32 || cast->src[0]->type != GGML_TYPE_BF16 ||
+        norm->op != GGML_OP_NORM || norm->type != GGML_TYPE_F32 || norm->src[0] != cast ||
+        mul->op != GGML_OP_MUL || mul->src[0] != norm || !modulation_input(cast, mul->src[1], mul) ||
+        !ggml_is_contiguous(cast->src[0]) || !ggml_are_same_shape(cast->src[0], mul)) {
+        return false;
+    }
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(eps));
+    return eps >= 0.0f && modulation_disjoint(cast->src[0], mul) && modulation_disjoint(mul->src[1], mul);
+}
+
+void ggml_cuda_op_bf16_norm_mul(ggml_backend_cuda_context & ctx, const ggml_tensor * cast,
+                               const ggml_tensor * norm, ggml_tensor * mul) {
+    const ggml_tensor * x = cast->src[0];
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(eps));
+    norm_mul_bf16<1024><<<dim3(x->ne[1], x->ne[2], x->ne[3]), 1024, 32 * sizeof(float2), ctx.stream()>>>(
+        (const nv_bfloat16 *) x->data, (const float *) mul->src[1]->data, (float *) mul->data,
+        x->ne[0], x->nb[1] / sizeof(nv_bfloat16), x->nb[2] / sizeof(nv_bfloat16), x->nb[3] / sizeof(nv_bfloat16), eps);
+}
+
+bool ggml_cuda_can_fuse_bf16_gated_residual(const ggml_tensor * mul, const ggml_tensor * add) {
+    if (!mul || !add || mul->op != GGML_OP_MUL || add->op != GGML_OP_ADD || add->src[1] != mul ||
+        !modulation_input(mul->src[0], mul->src[1], mul) || add->type != GGML_TYPE_BF16 ||
+        add->src[0]->type != GGML_TYPE_BF16 || !ggml_are_same_shape(add->src[0], add) ||
+        !ggml_are_same_shape(mul, add) || !ggml_is_contiguous(add) || !ggml_is_contiguous(add->src[0])) {
+        return false;
+    }
+    return modulation_disjoint(mul->src[0], add) && modulation_disjoint(mul->src[1], add) &&
+           modulation_disjoint(add->src[0], add);
+}
+
+void ggml_cuda_op_bf16_gated_residual(ggml_backend_cuda_context & ctx, const ggml_tensor * mul, ggml_tensor * add) {
+    const int64_t size = ggml_nelements(add);
+    gated_residual_bf16<<<(size + 255) / 256, 256, 0, ctx.stream()>>>(
+        (const float *) mul->src[0]->data, (const float *) mul->src[1]->data,
+        (const nv_bfloat16 *) add->src[0]->data, (nv_bfloat16 *) add->data, size);
+}
+
+static __global__ void norm_mul_convrot_bf16(
+        const nv_bfloat16 * x, const float * mul, int8_t * dst, float * scales, const float eps) {
+    constexpr int k = 4096;
+    constexpr int block_size = 1024;
+    constexpr int group_size = 256;
+    constexpr int group_threads = group_size / 4;
+    constexpr int groups_per_wave = block_size / group_threads;
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    x += int64_t(row) * k;
+    int8_t * dst_row = dst + int64_t(row) * k;
+    __shared__ float2 s_sum2[32];
+    __shared__ float values[k];
+    __shared__ float maxima[32];
+    float2 mean_var = make_float2(0.0f, 0.0f);
+    ggml_cuda_pdl_sync();
+    // Match norm_mul_bf16's 1024-thread summation and F32 rounding exactly.
+    for (int col = tid; col < k; col += block_size) {
+        const float xi = __bfloat162float(x[col]);
+        mean_var.x += xi;
+        mean_var.y += xi * xi;
+    }
+    mean_var = block_reduce<block_reduce_method::SUM, block_size>(mean_var, s_sum2);
+    const float mean = mean_var.x / k;
+    const float var = mean_var.y / k - mean * mean;
+    const float inv_std = rsqrtf(var + eps);
+    for (int col = tid; col < k; col += block_size) {
+        const float value = __fmul_rn(__fmul_rn(__bfloat162float(x[col]) - mean, inv_std), mul[col]);
+        values[col] = __fmul_rn(value, 1.0f / 16.0f);
+    }
+    __syncthreads();
+    const int group_lane = tid % group_threads;
+    const int wave_group = tid / group_threads;
+    const int64_t groups = k / group_size;
+    for (int64_t group_base = 0; group_base < groups; group_base += groups_per_wave) {
+        const int64_t group = group_base + wave_group;
+#pragma unroll
+        for (int stride = 1; stride < group_size; stride *= 4) {
+            if (group < groups) {
+                float * group_values = values + group * group_size;
+                const int base       = (group_lane / stride) * 4 * stride + group_lane % stride;
+                const int i0         = base;
+                const int i1         = i0 + stride;
+                const int i2         = i1 + stride;
+                const int i3         = i2 + stride;
+                const float a        = group_values[i0];
+                const float b        = group_values[i1];
+                const float c        = group_values[i2];
+                const float d        = group_values[i3];
+                group_values[i0]     =  a + b + c - d;
+                group_values[i1]     =  a + b - c + d;
+                group_values[i2]     =  a - b + c + d;
+                group_values[i3]     = -a + b + c + d;
+            }
+            __syncthreads();
+        }
+    }
+
+    float local_max = 0.0f;
+    for (int64_t i = tid; i < k; i += blockDim.x) {
+        local_max = fmaxf(local_max, fabsf(values[i]));
+    }
+    local_max = warp_reduce_max<32>(local_max);
+    const int lane = tid & 31;
+    const int warp = tid >> 5;
+    if (lane == 0) {
+        maxima[warp] = local_max;
+    }
+    __syncthreads();
+
+    if (warp == 0) {
+        local_max = lane < blockDim.x / 32 ? maxima[lane] : 0.0f;
+        local_max = warp_reduce_max<32>(local_max);
+        if (lane == 0) {
+            maxima[0]  = local_max / 127.0f;
+            if (scales != nullptr) {
+                scales[row] = maxima[0];
+            } else {
+                *((float *)(dst_row + k)) = maxima[0];
+            }
+        }
+    }
+    __syncthreads();
+
+    const float row_scale = maxima[0];
+    const float inv_scale = row_scale == 0.0f ? 0.0f : 1.0f / row_scale;
+    for (int64_t i = tid; i < k; i += blockDim.x) {
+        int value  = row_scale == 0.0f ? 0 : __float2int_rn(values[i] * inv_scale);
+        value      = max(-127, min(127, value));
+        dst_row[i] = (int8_t)value;
+    }
+}
+
+bool ggml_cuda_can_fuse_bf16_norm_mul_convrot(const ggml_tensor * cast, const ggml_tensor * norm,
+        const ggml_tensor * mul, const ggml_tensor * view, const ggml_tensor * quant) {
+    if (!ggml_cuda_can_fuse_bf16_norm_mul(cast, norm, mul) || !view || !quant ||
+        view->op != GGML_OP_VIEW || view->src[0] != mul || view->view_offs != 0 ||
+        !ggml_are_same_shape(view, mul) || !ggml_is_contiguous(view) ||
+        quant->op != GGML_OP_QUANTIZE_I8_CONVROT || quant->src[0] != view ||
+        quant->type != GGML_TYPE_I8 || quant->op_params[0] != 256 || !ggml_is_contiguous(quant)) return false;
+    const ggml_tensor * x = cast->src[0];
+    const int64_t rows = ggml_nrows(x);
+    return x->ne[2] == 1 && x->ne[3] == 1 && rows > 0 && rows <= INT32_MAX &&
+        quant->ne[0] == 4096 && ggml_nbytes(quant) >= size_t(GGML_PAD(rows, 4) * 4096 + rows * sizeof(float)) &&
+        modulation_disjoint(x, quant) && modulation_disjoint(mul->src[1], quant);
+}
+
+void ggml_cuda_op_bf16_norm_mul_convrot(ggml_backend_cuda_context & ctx, const ggml_tensor * cast,
+        const ggml_tensor * norm, const ggml_tensor * mul, ggml_tensor * quant) {
+    const ggml_tensor * x = cast->src[0];
+    const int64_t rows = ggml_nrows(x), padded = GGML_PAD(rows, 4);
+    auto data = static_cast<int8_t *>(quant->data);
+    if (padded > rows) CUDA_CHECK(cudaMemsetAsync(data + rows*4096, 0, (padded-rows)*4096, ctx.stream()));
+    norm_mul_convrot_bf16<<<rows, 1024, 0, ctx.stream()>>>(static_cast<const nv_bfloat16 *>(x->data),
+        static_cast<const float *>(mul->src[1]->data), data,
+        reinterpret_cast<float *>(data + padded*4096), ggml_get_op_params_f32(norm, 0));
+}
