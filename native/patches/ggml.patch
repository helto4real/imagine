+        return false;
+    }
+
+    Epilogue::Arguments epilogue{
+        {{ {}, {input_scales, 1.0f, {}}, {} }, {weight_scales, 1.0f, {}}, {}},
+        {output, {n, cute::_1{}, cute::_0{}}}};
+    Gemm::Arguments args{
+        cutlass::gemm::GemmUniversalMode::kGemm, {(int)rows, (int)n, (int)k}, 1,
+        epilogue, input, weights, nullptr, output,
+        0, 0, 0, 0, k, k, n, n};
+    Gemm gemm;
