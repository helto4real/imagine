+static __global__ void rms_norm_rope_apply_f32(
+        const float * x, const float * weight, const float * pe, float * dst,
+        int64_t heads, int64_t tokens, float eps, RopeApplyStrides strides) {
+    const int col = threadIdx.x;
+    const int64_t row = blockIdx.x;
+    const int64_t head = row % heads;
+    const int64_t token = (row / heads) % tokens;
+    const int64_t batch = row / (heads * tokens);
+    const float * input = x + head * strides.x[1] + token * strides.x[2] + batch * strides.x[3];
+    ggml_cuda_pdl_sync();
+    const float value = input[col];
+    float sum = 0.0f;
+    sum += value * value;
+    extern __shared__ float partial[];
+    // The 256-thread norm has four additional zero warps for this head width.
+    sum = block_reduce<block_reduce_method::SUM, 128>(sum, partial);
+    const float scale = rsqrtf(sum / 128.0f + eps);
+    if (col < 64) {
+        const int i = 2 * col;
+        const float a = __fmul_rn(__fmul_rn(scale, input[i]), weight[i]);
+        const float b = __fmul_rn(__fmul_rn(scale, input[i + 1]), weight[i + 1]);
+        const float * matrix = pe + col * strides.pe[2] + token * strides.pe[3];
+        float * output = dst + ((batch * heads + head) * tokens + token) * 128;
+        output[i] = __fadd_rn(__fmul_rn(a, matrix[0]), __fmul_rn(b, matrix[strides.pe[0]]));
+        output[i + 1] = __fadd_rn(__fmul_rn(a, matrix[strides.pe[1]]),
+                                __fmul_rn(b, matrix[strides.pe[0] + strides.pe[1]]));
+    }
+    ggml_cuda_pdl_lc();
+}
+
+bool ggml_cuda_can_fuse_rms_norm_rope_apply(const ggml_tensor * norm, const ggml_tensor * mul, const ggml_tensor * rope, bool check_memory) {
+    if (norm->op != GGML_OP_RMS_NORM || mul->op != GGML_OP_MUL || rope->op != GGML_OP_ROPE_APPLY ||
+        mul->src[0] != norm || rope->src[0] != mul || ggml_get_op_params_i32(rope, 0) != 1) {
+        return false;
+    }
+    const ggml_tensor * x = norm->src[0];
+    const ggml_tensor * weight = mul->src[1];
+    const ggml_tensor * pe = rope->src[1];
+    if (x->type != GGML_TYPE_F32 || norm->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        weight->type != GGML_TYPE_F32 || pe->type != GGML_TYPE_F32 || rope->type != GGML_TYPE_F32 ||
+        x->ne[0] != 128 || !ggml_is_contiguous_rows(x) || !ggml_is_contiguous(weight) ||
+        weight->ne[0] != 128 || ggml_nelements(weight) != 128 ||
+        !ggml_are_same_shape(x, norm) || !ggml_are_same_shape(x, mul) ||
+        pe->ne[0] != 2 || pe->ne[1] != 2 || pe->ne[2] != 64 || pe->ne[3] != x->ne[2] ||
+        !ggml_is_contiguous(rope) || rope->ne[0] != 128 || rope->ne[1] != x->ne[2] ||
+        rope->ne[2] != x->ne[1] * x->ne[3] || rope->ne[3] != 1 ||
+        ggml_nrows(x) > INT32_MAX) {
+        return false;
+    }
+    if (!check_memory) {
+        return true;
+    }
+    // Include leaf inputs: the generic fusion range check skips GGML_OP_NONE.
+    for (const ggml_tensor * input : {x, weight, pe}) {
+        const uintptr_t begin = (uintptr_t) input->data;
+        const uintptr_t output = (uintptr_t) rope->data;
+        if (begin < output + ggml_nbytes(rope) && output < begin + ggml_nbytes(input)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void ggml_cuda_op_rms_norm_rope_apply(ggml_backend_cuda_context & ctx, const ggml_tensor * norm, const ggml_tensor * mul, ggml_tensor * rope) {
+    const ggml_tensor * x = norm->src[0];
+    const ggml_tensor * pe = rope->src[1];
+    RopeApplyStrides strides;
+    for (int i = 0; i < 4; ++i) {
+        strides.x[i] = x->nb[i] / sizeof(float);
+        strides.pe[i] = pe->nb[i] / sizeof(float);
+    }
+    const ggml_cuda_kernel_launch_params launch_params = {
+        dim3(ggml_nrows(x)), dim3(128), 32 * sizeof(float), ctx.stream()};
+    ggml_cuda_kernel_launch(rms_norm_rope_apply_f32, launch_params,
+        (const float *) x->data, (const float *) mul->src[1]->data, (const float *) pe->data,
+        (float *) rope->data, x->ne[1], x->ne[2], ggml_get_op_params_f32(norm, 0), strides);
+}
+
+static __global__ void rms_norm_rope_apply_bf16(
+        const nv_bfloat16 * x, const float * weight, const float * pe, nv_bfloat16 * dst,
+        int64_t heads, int64_t tokens, float eps, RopeApplyStrides strides) {
+    const int col = threadIdx.x;
+    const int64_t row = blockIdx.x;
+    const int64_t head = row % heads;
+    const int64_t token = (row / heads) % tokens;
+    const int64_t batch = row / (heads * tokens);
+    const nv_bfloat16 * input = x + head * strides.x[1] + token * strides.x[2] + batch * strides.x[3];
+    ggml_cuda_pdl_sync();
+    const float value = input[col];
+    float sum = 0.0f;
+    sum += value * value;
+    extern __shared__ float partial[];
+    // The 256-thread norm has four additional zero warps for this head width.
+    sum = block_reduce<block_reduce_method::SUM, 128>(sum, partial);
+    const float scale = rsqrtf(sum / 128.0f + eps);
+    if (col < 64) {
+        const int i = 2 * col;
+        const float a = __fmul_rn(__fmul_rn(scale, input[i]), weight[i]);
+        const float b = __fmul_rn(__fmul_rn(scale, input[i + 1]), weight[i + 1]);
+        const float * matrix = pe + col * strides.pe[2] + token * strides.pe[3];
+        nv_bfloat16 * output = dst + ((batch * heads + head) * tokens + token) * 128;
+        output[i] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(a, matrix[0]), __fmul_rn(b, matrix[strides.pe[0]])));
+        output[i + 1] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(a, matrix[strides.pe[1]]),
+                                __fmul_rn(b, matrix[strides.pe[0] + strides.pe[1]])));
+    }
+    ggml_cuda_pdl_lc();
+}
+
+static __global__ void paired_rms_norm_rope_apply_bf16(
+        const nv_bfloat16 * q, const nv_bfloat16 * k,
+        const float * qw, const float * kw, const float * pe,
+        nv_bfloat16 * qdst, nv_bfloat16 * kdst,
+        int64_t heads, int64_t tokens, float qeps, float keps, RopeApplyStrides strides) {
+    const int col = threadIdx.x;
+    const int64_t row = blockIdx.x;
+    const int64_t head = row % heads;
+    const int64_t token = (row / heads) % tokens;
+    const int64_t batch = row / (heads * tokens);
+    const int64_t offset = head * strides.x[1] + token * strides.x[2] + batch * strides.x[3];
+    const nv_bfloat16 * qi = q + offset, * ki = k + offset;
+    ggml_cuda_pdl_sync();
+    const float qv = qi[col], kv = ki[col];
+    float qs = 0.0f, ks = 0.0f;
+    qs += qv * qv;
+    ks += kv * kv;
+    extern __shared__ float partial[];
+    // Preserve each 128-thread reduction; disjoint scratch avoids reuse races.
+    qs = block_reduce<block_reduce_method::SUM, 128>(qs, partial);
+    ks = block_reduce<block_reduce_method::SUM, 128>(ks, partial + 32);
+    const float qscale = rsqrtf(qs / 128.0f + qeps);
+    const float kscale = rsqrtf(ks / 128.0f + keps);
+    if (col < 64) {
+        const int i = 2 * col;
+        const float qa = __fmul_rn(__fmul_rn(qscale, qi[i]), qw[i]);
+        const float qb = __fmul_rn(__fmul_rn(qscale, qi[i + 1]), qw[i + 1]);
+        const float ka = __fmul_rn(__fmul_rn(kscale, ki[i]), kw[i]);
+        const float kb = __fmul_rn(__fmul_rn(kscale, ki[i + 1]), kw[i + 1]);
+        const float * matrix = pe + col * strides.pe[2] + token * strides.pe[3];
+        const float m00 = matrix[0], m01 = matrix[strides.pe[0]];
+        const float m10 = matrix[strides.pe[1]], m11 = matrix[strides.pe[0] + strides.pe[1]];
+        const int64_t out = ((batch * heads + head) * tokens + token) * 128 + i;
+        qdst[out] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(qa, m00), __fmul_rn(qb, m01)));
+        qdst[out + 1] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(qa, m10), __fmul_rn(qb, m11)));
+        kdst[out] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(ka, m00), __fmul_rn(kb, m01)));
+        kdst[out + 1] = __float2bfloat16_rn(__fadd_rn(__fmul_rn(ka, m10), __fmul_rn(kb, m11)));
+    }
+    ggml_cuda_pdl_lc();
+}
+
+bool ggml_cuda_can_fuse_bf16_rms_rope(const ggml_tensor * cast, const ggml_tensor * norm,
+        const ggml_tensor * mul, const ggml_tensor * rope, const ggml_tensor * out) {
+    const ggml_tensor * x = cast->src[0];
+    if (!x || cast->op != GGML_OP_CPY || cast->type != GGML_TYPE_F32 || x->type != GGML_TYPE_BF16 ||
+        norm->src[0] != cast || out->op != GGML_OP_CPY || out->src[0] != rope || out->type != GGML_TYPE_BF16 ||
+        !ggml_are_same_shape(x, cast) || !ggml_are_same_shape(out, rope) || !ggml_is_contiguous(x) ||
+        !ggml_is_contiguous(out) || !ggml_cuda_can_fuse_rms_norm_rope_apply(norm, mul, rope, false)) return false;
+    const ggml_tensor * inputs[] = {x, mul->src[1], rope->src[1]};
+    for (const ggml_tensor * input : inputs) {
+        const uintptr_t a = (uintptr_t) input->data, b = (uintptr_t) out->data;
+        if (a < b + ggml_nbytes(out) && b < a + ggml_nbytes(input)) return false;
+    }
+    return true;
+}
+
+void ggml_cuda_op_bf16_rms_rope(ggml_backend_cuda_context & ctx, const ggml_tensor * cast,
+        const ggml_tensor * norm, const ggml_tensor * mul, const ggml_tensor * rope, ggml_tensor * out) {
+    const ggml_tensor * x = cast->src[0], * pe = rope->src[1];
+    RopeApplyStrides strides;
+    for (int i = 0; i < 4; ++i) {
+        strides.x[i] = x->nb[i] / sizeof(nv_bfloat16);
+        strides.pe[i] = pe->nb[i] / sizeof(float);
+    }
+    const ggml_cuda_kernel_launch_params params = {dim3(ggml_nrows(x)), dim3(128), 32 * sizeof(float), ctx.stream()};
+    ggml_cuda_kernel_launch(rms_norm_rope_apply_bf16, params, (const nv_bfloat16 *) x->data,
+        (const float *) mul->src[1]->data, (const float *) pe->data, (nv_bfloat16 *) out->data,
+        x->ne[1], x->ne[2], ggml_get_op_params_f32(norm, 0), strides);
+}
+
+bool ggml_cuda_can_fuse_bf16_qk_rms_rope(ggml_tensor * const * nodes) {
+    for (int offset : {0, 5}) {
+        if (!ggml_cuda_can_fuse_bf16_rms_rope(nodes[offset], nodes[offset+1], nodes[offset+2],
+                nodes[offset+3], nodes[offset+4])) return false;
+    }
+    const ggml_tensor * q = nodes[0]->src[0], * k = nodes[5]->src[0];
+    if (!ggml_are_same_shape(q, k) || nodes[3]->src[1] != nodes[8]->src[1]) return false;
+    const ggml_tensor * inputs[] = {q, k, nodes[2]->src[1], nodes[7]->src[1], nodes[3]->src[1]};
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t x = (uintptr_t) a->data, y = (uintptr_t) b->data;
+        return x < y + ggml_nbytes(b) && y < x + ggml_nbytes(a);
+    };
+    for (const ggml_tensor * input : inputs) {
+        if (overlaps(input, nodes[4]) || overlaps(input, nodes[9])) return false;
+    }
+    return !overlaps(nodes[4], nodes[9]);
+}
+
+void ggml_cuda_op_bf16_qk_rms_rope(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes) {
+    const ggml_tensor * q = nodes[0]->src[0], * k = nodes[5]->src[0], * pe = nodes[3]->src[1];
+    RopeApplyStrides strides;
+    for (int i = 0; i < 4; ++i) {
+        strides.x[i] = q->nb[i] / sizeof(nv_bfloat16);
+        strides.pe[i] = pe->nb[i] / sizeof(float);
+    }
+    const ggml_cuda_kernel_launch_params params = {dim3(ggml_nrows(q)), dim3(128), 64 * sizeof(float), ctx.stream()};
+    ggml_cuda_kernel_launch(paired_rms_norm_rope_apply_bf16, params,
+        (const nv_bfloat16 *) q->data, (const nv_bfloat16 *) k->data,
+        (const float *) nodes[2]->src[1]->data, (const float *) nodes[7]->src[1]->data, (const float *) pe->data,
+        (nv_bfloat16 *) nodes[4]->data, (nv_bfloat16 *) nodes[9]->data,
+        q->ne[1], q->ne[2], ggml_get_op_params_f32(nodes[1], 0), ggml_get_op_params_f32(nodes[6], 0), strides);
+}
