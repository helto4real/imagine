+                main_capacity = pool->pool_size;
+                main_used = pool->pool_used;
+            }
+        }
+    }
+    peak = peak > SIZE_MAX - main_used ? SIZE_MAX : peak + main_used;
+    const size_t missing = peak > main_capacity ? peak - main_capacity : 0;
+    const size_t granularity = info.vmm_granularity;
+    *growth = missing > SIZE_MAX - (granularity - 1) ? SIZE_MAX :
+              ((missing + granularity - 1) / granularity) * granularity;
+    return true;
+#else
+    GGML_UNUSED(backend);
+    GGML_UNUSED(graph);
+    return false;
+#endif
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+    if (strcmp(name, "ggml_backend_cuda_graph_pool_memory") == 0) {
+        return (void *)ggml_backend_cuda_graph_pool_memory;
+    }
     if (strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_cuda_comm_init;
     }
