+// A bound for cuBLAS floating-point matmuls, including conversions and pointer arrays.
+// Other kernels and library-private allocations retain the caller's safety reserve.
+static size_t ggml_cuda_cublas_pool_bytes(const ggml_tensor * dst, int cc) {
+    const auto * a = dst->src[0];
+    const auto * b = dst->src[1];
+    const auto is_float = [](ggml_type t) {
+        return t == GGML_TYPE_F16 || t == GGML_TYPE_BF16 || t == GGML_TYPE_F32;
+    };
+    if (dst->op != GGML_OP_MUL_MAT || !is_float(a->type) || !is_float(b->type)) {
+        return 0;
+    }
+    const ggml_type type = ggml_cuda_cublas_compute_type(cc, a, b, dst);
+    const size_t element_bytes = ggml_type_size(type);
+    size_t bytes = 0;
+    const auto add_allocation = [&](size_t count, size_t width) {
+        if (count > (SIZE_MAX - 127) / width) {
+            bytes = SIZE_MAX;
+            return;
+        }
+        const size_t aligned = ((count * width + 127) / 128) * 128;
+        bytes = aligned > SIZE_MAX - bytes ? SIZE_MAX : bytes + aligned;
+    };
+    if (a->type != type) {
+        add_allocation(ggml_nelements(a), element_bytes);
+    }
+    if (b->type != type) {
+        add_allocation(ggml_nelements(b), element_bytes);
+    }
+    if (type != GGML_TYPE_F32 && !ggml_cuda_cublas_f32_output(type, cc)) {
+        add_allocation(ggml_nelements(dst), element_bytes);
+    }
+    const bool a_cont = ggml_is_contiguous_2(a) || (a->type != type && !ggml_is_contiguously_allocated(a));
+    const bool b_cont = ggml_is_contiguous_2(b) || (b->type != type && !ggml_is_contiguously_allocated(b));
+    if (!(b->ne[2] == 1 && b->ne[3] == 1) &&
+        !(a->ne[2] == b->ne[2] && a->ne[3] == b->ne[3] && a_cont && b_cont)) {
+        const size_t batch = b->ne[2] * b->ne[3];
+        add_allocation(batch, 2 * sizeof(void *));
+        add_allocation(batch, sizeof(void *));
+    }
+    return bytes;
+}
