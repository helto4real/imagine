+    static const bool down_enabled = [] {
+        const char * value = getenv("GGML_CUDA_FUSED_INT8_DOWN");
+        return value != nullptr && strcmp(value, "1") == 0;
+    }();
+    // The projection kernel loses to cuBLAS on short sequences; 512 rows is the measured floor.
+    const bool enabled = (k == 4096 && ((n == 24576 && gate_up_enabled) ||
+                         (n == 4096 && rows >= 512 && projection_enabled))) ||
+                         (k == 12288 && n == 4096 && rows >= 4096 && down_enabled);
