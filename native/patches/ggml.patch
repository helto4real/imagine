+bool ggml_cuda_can_fuse_int8_down_residual(const ggml_tensor * mat, const ggml_tensor * view,
+        const ggml_tensor * mul, const ggml_tensor * out) {
+    return can_fuse_int8_projection_residual(mat, mat, view, mul, out, 12288);
