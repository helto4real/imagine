+static __global__ void gate_up_swiglu_pack(const int4 * weights, int4 * packed,
+        const float * scales, float * packed_scales) {
+    constexpr int k = 4096, half = 12288;
+    const int col = blockIdx.x;
+    const int source_col = (col & 1) * half + col / 2;
+    const int i = threadIdx.x;
+    packed[size_t(col) * (k / 16) + i] = weights[size_t(source_col) * (k / 16) + i];
+    if (i == 0) packed_scales[col] = scales[source_col];
+}
