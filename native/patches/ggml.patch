+    const int64_t rows = ggml_nrows(mat);
+    if (ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_ADA_LOVELACE ||
+        mat->op != GGML_OP_MUL_MAT || !ggml_mul_mat_has_packed_i8_input(mat) ||
+        mat->op_params[2] != 256 || mat->src[3] || mat->type != GGML_TYPE_F32 ||
+        mat->ne[0] != n || mat->ne[2] != 1 || mat->ne[3] != 1 || rows < 1025 || rows > INT32_MAX ||
+        glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->op_params[1] != 0 ||
+        glu->src[0] != mat || glu->src[1] || glu->type != GGML_TYPE_F32 || glu->ne[0] != n/2 ||
+        ggml_nrows(glu) != rows || glu->ne[2] != 1 || glu->ne[3] != 1 ||
+        !ggml_is_contiguous(mat) || !ggml_is_contiguous(glu)) return false;
+    const ggml_tensor * w = mat->src[0], * x = mat->src[1], * ws = mat->src[2];
+    if (!w || !x || !ws || w->type != GGML_TYPE_I8 || x->type != GGML_TYPE_I8 || ws->type != GGML_TYPE_F32 ||
+        w->ne[0] != k || w->ne[1] != n || w->ne[2] != 1 || w->ne[3] != 1 ||
+        x->ne[0] != k || ggml_nbytes(x) < size_t(GGML_PAD(rows,4)*k + rows*sizeof(float)) ||
+        ggml_nelements(ws) != n || !ggml_is_contiguous(w) || !ggml_is_contiguous(x) || !ggml_is_contiguous(ws) ||
+        ggml_nbytes(mat) < size_t(n*k + n*sizeof(float))) return false;
+    auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t x = (uintptr_t)a->data, y = (uintptr_t)b->data;
+        return x < y + ggml_nbytes(b) && y < x + ggml_nbytes(a);
+    };
+    for (const ggml_tensor * input : {w, x, ws}) {
+        if (overlap(mat,input) || overlap(glu,input)) return false;
+    }
+    if (overlap(mat,glu) || (uintptr_t)w->data % 16 || (uintptr_t)x->data % 16 ||
+        (uintptr_t)mat->data % 16 || (uintptr_t)glu->data % 16) return false;
+
+    static const bool direct = [] {
+        const char * value = getenv("GGML_CUDA_GATE_UP_DIRECT");
+        return value != nullptr && strcmp(value, "1") == 0;
+    }();
+    if (direct) {
+        const float * row_scales = (const float *)((const int8_t *)x->data + GGML_PAD(rows,4)*k);
+        DirectGateUpSwiGLU::Epilogue::Arguments ep{
+            {{{},{row_scales,1.f,{}},{}},{(const float *)ws->data,1.f,{}},{}},
+            {(float *)glu->data,{n,cute::_1{},cute::_0{}}}};
+        DirectGateUpSwiGLU::Gemm::Arguments args{
+            cutlass::gemm::GemmUniversalMode::kGemm,{(int)rows,(int)n,(int)k},1,
+            ep,x->data,w->data,nullptr,glu->data,0,0,0,0,k,k,n,n};
+        DirectGateUpSwiGLU::Gemm gemm;
+        if (gemm.can_implement(args) != cutlass::Status::kSuccess) return false;
+        GGML_ASSERT(gemm.get_workspace_size(args) == 0);
+        const auto status = gemm(args,nullptr,ctx.stream());
+        if (status != cutlass::Status::kSuccess) {
+            GGML_ABORT("Direct gate/up SwiGLU launch failed: %s",cutlass::cutlassGetStatusString(status));
+        }
+        return true;
+    }
+
+    // The elided matrix output is graph-owned scratch, visible to auto-fit.
+    auto * packed = (int8_t *)mat->data;
+    auto * scales = (float *)(packed + n*k);
+    const float * row_scales = (const float *)((const int8_t *)x->data + GGML_PAD(rows,4)*k);
+    GateUpSwiGLUProjection::Epilogue::Arguments ep{
+        {{{},{row_scales,1.f,{}},{}},{scales,1.f,{}},{}},
+        {(float *)glu->data,{n,cute::_1{},cute::_0{}}}};
+    GateUpSwiGLUProjection::Gemm::Arguments args{
+        cutlass::gemm::GemmUniversalMode::kGemm,{(int)rows,(int)n,(int)k},1,
+        ep,x->data,packed,nullptr,glu->data,0,0,0,0,k,k,n,n};
+    GateUpSwiGLUProjection::Gemm gemm;
+    if (gemm.can_implement(args) != cutlass::Status::kSuccess) return false;
+    GGML_ASSERT(gemm.get_workspace_size(args) == 0);
+    gate_up_swiglu_pack<<<n,256,0,ctx.stream()>>>((const int4 *)w->data,(int4 *)packed,(const float *)ws->data,scales);
+    CUDA_CHECK(cudaGetLastError());
+    const auto status = gemm(args,nullptr,ctx.stream());
+    if (status != cutlass::Status::kSuccess) GGML_ABORT("Fused gate/up SwiGLU launch failed: %s",cutlass::cutlassGetStatusString(status));
+    return true;
+}
+
+#endif
