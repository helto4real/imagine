+static bool can_fuse_int8_projection_residual(const ggml_tensor * mat, const ggml_tensor * projected,
+        const ggml_tensor * view, const ggml_tensor * mul, const ggml_tensor * out, int64_t k) {
+    if (!mat || !projected || !view || !mul || !out || mat->op != GGML_OP_MUL_MAT || mat->type != GGML_TYPE_F32 ||
+        !ggml_mul_mat_has_packed_i8_input(mat) || ggml_get_op_params_i32(mat, 2) != 256 || mat->src[3] ||
+        view->op != GGML_OP_VIEW || view->src[0] != projected || view->view_offs != 0 ||
+        !ggml_are_same_shape(view, mat) || !ggml_is_contiguous(view) ||
+        mul->op != GGML_OP_MUL || mul->src[0] != view || mul->type != GGML_TYPE_F32 ||
+        out->op != GGML_OP_ADD || out->src[1] != mul || out->type != GGML_TYPE_BF16) return false;
+    const ggml_tensor * w = mat->src[0], * x = mat->src[1], * scales = mat->src[2];
+    const ggml_tensor * gate = mul->src[1], * residual = out->src[0];
+    const int64_t rows = ggml_nrows(mat);
+    if (!w || !x || !scales || !gate || !residual || w->type != GGML_TYPE_I8 || x->type != GGML_TYPE_I8 ||
+        w->ne[0] != k || w->ne[1] != 4096 || w->ne[2] != 1 || w->ne[3] != 1 ||
+        rows < 4096 || rows > INT32_MAX || mat->ne[0] != 4096 || mat->ne[2] != 1 || mat->ne[3] != 1 ||
+        scales->type != GGML_TYPE_F32 || ggml_nelements(scales) != 4096 ||
+        gate->type != GGML_TYPE_F32 || gate->ne[0] != 4096 || ggml_nelements(gate) != 4096 ||
+        residual->type != GGML_TYPE_BF16 || !ggml_are_same_shape(mat, residual) ||
+        !ggml_are_same_shape(mat, mul) || !ggml_are_same_shape(mat, out) ||
+        x->ne[0] != k || ggml_nbytes(x) < size_t(GGML_PAD(rows, 4)*k + rows*sizeof(float)) ||
+        !ggml_is_contiguous(mat) || !ggml_is_contiguous(mul) || !ggml_is_contiguous(out)) return false;
+    for (const ggml_tensor * input : {w, x, scales, gate, residual}) {
+        if (!ggml_is_contiguous(input)) return false;
+        const uintptr_t a = (uintptr_t)input->data, b = (uintptr_t)out->data;
+        if (a < b + ggml_nbytes(out) && b < a + ggml_nbytes(input)) return false;
+    }
+    return true;
+}
