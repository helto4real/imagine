+bool ModelManager::can_merge_int8_loras(const std::vector<LoraSpec>& loras, SDVersion version) {
+#ifndef SD_USE_CUDA
+    return false;
+#else
+    if (version != VERSION_QWEN_IMAGE_2_1 || loras.empty())
+        return false;
+    std::map<std::string, TensorState*> targets;
+    TensorState* first = nullptr;
+    for (const auto& state : tensor_states_) {
+        if (state->component == ModelComponent::LoRA)
+            continue;
+        targets[state->name] = state.get();
+        if (!first && state->component == ModelComponent::Diffusion)
+            first = state.get();
+    }
+    if (!first || !sd_backend_is(first->compute_backend, "CUDA"))
+        return false;
+    auto borrowed = std::shared_ptr<ModelManager>(this, [](ModelManager*) {});
+    for (const auto& spec : loras) {
+        auto adapter               = std::make_shared<LoraModel>(lora_id(spec), first->compute_backend, first->params_backend,
+                                                                 borrowed, spec.file_id, version, first->residency_mode);
+        LoraModel::filter_t filter = nullptr;
+        if (!spec.tensor_name_prefix_filter.empty())
+            filter = [&](const std::string& n) { return starts_with(n, spec.tensor_name_prefix_filter); };
+        if (!adapter->init_params(n_threads_, filter))
+            return false;
+        adapter->preprocess_lora_tensors(tensor_names());
+        if (adapter->lora_tensors.empty())
+            return false;
+        for (const auto& entry : adapter->lora_tensors) {
+            std::string key = entry.first;
+            bool recognized = false;
+            for (const char* suffix : {".lora_up", ".lora_down", ".alpha", ".scale"}) {
+                if (ends_with(key, suffix)) {
+                    key.resize(key.size() - std::strlen(suffix));
+                    recognized = true;
+                    break;
+                }
+            }
+            if (!recognized || !starts_with(key, "lora."))
+                return false;
+            std::string target = key.substr(5);
+            const bool half    = ends_with(target, ".weight.1");
+            if (half)
+                target.resize(target.size() - 2);
+            auto found = targets.find(target);
+            if (found == targets.end())
+                return false;
+            auto* state     = found->second;
+            const int width = int(state->tensor->ne[0]), rows = int(state->tensor->ne[1]);
+            if (state->tensor->type != GGML_TYPE_I8 || state->split_buffer_type ||
+                !sd_backend_is(state->compute_backend, "CUDA") || state->sources.empty() ||
+                !state->sources.front().is_int8_tensorwise || !state->sources.front().int8_convrot ||
+                state->sources.front().int8_convrot_group_size != 256 || width < 256 || width > 24576 || width % 256 ||
+                targets.count(target + "_scale") == 0)
+                return false;
+            auto up   = adapter->lora_tensors.find(key + ".lora_up");
+            auto down = adapter->lora_tensors.find(key + ".lora_down");
+            if (up == adapter->lora_tensors.end() || down == adapter->lora_tensors.end())
+                return false;
+            const int rank = int(down->second->ne[1]), out = int(up->second->ne[1]);
+            const bool gate = ends_with(target, ".img_mlp.gate_up.weight");
+            if (ggml_n_dims(up->second) > 2 || ggml_n_dims(down->second) > 2 || rank < 1 || rank > 256 ||
+                down->second->ne[0] != width || up->second->ne[0] != rank ||
+                !((!half && out == rows) || (gate && rows % 2 == 0 && out == rows / 2)))
+                return false;
+        }
+    }
+    return true;
+#endif
+}
