+static __global__ void lora_output_f16_f32(const half * input, ggml_cuda_lora_output epilogue, int64_t n) {
+    const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    float value = __half2float(input[i]);
+    // Each SCALE keeps its own F32 rounding, including the attention rescale.
+    for (int j = 0; j < epilogue.count; ++j) {
+        value = __fmaf_rn(epilogue.scales[j], value, epilogue.biases[j]);
+    }
+    epilogue.output[i] = __fadd_rn(epilogue.base[i], value);
+}
