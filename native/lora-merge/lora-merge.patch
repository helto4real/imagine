@@ -0,0 +1,214 @@
+// ConvRot butterfly, scale rounding and PCG stochastic quantization adapted from
+// Comfy Kitchen 0.2.37 int8.cu. Copyright (c) 2025 Comfy Org. Apache-2.0.
+// The whole-matrix integration and patch application are native Imagine code.
+#include <cublas_v2.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <cmath>
+#include <vector>
+#include "lora_int8_merge.h"
+
+static __device__ float half_round(float x) {
+    return __half2float(__float2half_rn(x));
+}
+static __device__ uint32_t pcg(uint32_t x) {
+    uint32_t state = x * 747796405u + 2891336453u;
+    uint32_t word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
+    return (word >> 22u) ^ word;
+}
+static __device__ float noise(uint64_t index, uint64_t seed) {
+    uint64_t key = index + seed;
+    return half_round(float(pcg(uint32_t(key) ^ uint32_t(key >> 32)) >> 8) * 0x1.0p-24f);
+}
+
+// Group-local rotation has the same staged arithmetic and final rounding as
+// Kitchen's groups64 kernels; applying the normalized butterfly twice is identity.
+static __global__ void lora_merge_unrotate(const int8_t* q, const float* scales, half* output, int width, int group) {
+    __shared__ float a[256], b[256];
+    const int lane = threadIdx.x;
+    const int row  = blockIdx.x;
+    const int base = blockIdx.y * group;
+    a[lane]        = float(q[row * width + base + lane]) * scales[row];
+    __syncthreads();
+    float* src = a;
+    float* dst = b;
+    for (int stride = 1; stride < group; stride *= 4) {
+        const int quad  = (lane / (4 * stride)) * (4 * stride) + lane % stride;
+        const int which = (lane / stride) % 4;
+        float x0 = src[quad], x1 = src[quad + stride], x2 = src[quad + 2 * stride], x3 = src[quad + 3 * stride];
+        float y   = which == 0 ? .5f * (x0 + x1 + x2 - x3) : which == 1 ? .5f * (x0 + x1 - x2 + x3)
+                                                         : which == 2   ? .5f * (x0 - x1 + x2 + x3)
+                                                                        : .5f * (-x0 + x1 + x2 + x3);
+        dst[lane] = y;
+        __syncthreads();
+        float* swap = src;
+        src         = dst;
+        dst         = swap;
+    }
+    output[row * width + base + lane] = __float2half_rn(src[lane]);
+}
+
+static __global__ void lora_merge_add(half* base, const float* diff, float strength, int64_t count) {
+    int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < count) {
+        // torch: FP32 product -> FP32 strength -> FP16 delta -> FP16 addition.
+        half delta = __float2half_rn(__fmul_rn(diff[i], strength));
+        base[i]    = __hadd(base[i], delta);
+    }
+}
+
+// Kitchen-style row-local ConvRot + quantization: no full FP32 rotated copy.
+// FP32 rotation/scale calculation, followed by the original FP16 rounding stages.
+static __global__ void lora_merge_quantize(const half* input, int8_t* q, float* scales, int width, uint64_t seed) {
+    extern __shared__ float storage[];
+    float* row_data = storage;
+    float* scratch  = storage + width;
+    __shared__ float maxima[256];
+    const int tid = threadIdx.x, row = blockIdx.x;
+    const int64_t offset = int64_t(row) * width;
+    for (int col = tid; col < width; col += 256)
+        row_data[col] = __half2float(input[offset + col]);
+    __syncthreads();
+    for (int group = 0; group < width; group += 256) {
+        float* src = row_data + group;
+        float* dst = scratch;
+        for (int stride = 1; stride < 256; stride *= 4) {
+            const int quad  = (tid / (4 * stride)) * (4 * stride) + tid % stride;
+            const int which = (tid / stride) % 4;
+            float x0 = src[quad], x1 = src[quad + stride], x2 = src[quad + 2 * stride], x3 = src[quad + 3 * stride];
+            dst[tid] = which == 0 ? .5f * (x0 + x1 + x2 - x3) : which == 1 ? .5f * (x0 + x1 - x2 + x3)
+                                                            : which == 2   ? .5f * (x0 - x1 + x2 + x3)
+                                                                           : .5f * (-x0 + x1 + x2 + x3);
+            __syncthreads();
+            float* swap = src;
+            src         = dst;
+            dst         = swap;
+        }
+    }
+    float maximum = 0;
+    for (int col = tid; col < width; col += 256)
+        maximum = fmaxf(maximum, fabsf(row_data[col]));
+    maxima[tid] = maximum;
+    __syncthreads();
+    for (int stride = 128; stride; stride /= 2) {
+        if (tid < stride)
+            maxima[tid] = fmaxf(maxima[tid], maxima[tid + stride]);
+        __syncthreads();
+    }
+    float scale = fmaxf(fminf(maxima[0], 65504.f) * (1.f / 127.f), 1.e-30f);
+    if (tid == 0)
+        scales[row] = scale;
+    for (int col = tid; col < width; col += 256) {
+        const int64_t i = offset + col;
+        float value     = half_round(half_round(row_data[col]) / half_round(scale));
+        float v         = seed ? floorf(half_round(value + noise(i, seed))) : nearbyintf(value);
+        q[i]            = int8_t(fminf(127.f, fmaxf(-128.f, v)));
+    }
+}
+
+struct MergeCudaWorkspace {
+    void* memory          = nullptr;
+    cublasHandle_t handle = nullptr;
+    cudaStream_t stream   = nullptr;
+    ~MergeCudaWorkspace() {
+        if (stream)
+            cudaStreamSynchronize(stream);
+        if (handle)
+            cublasDestroy(handle);
+        if (memory)
+            cudaFree(memory);
+        if (stream)
+            cudaStreamDestroy(stream);
+    }
+};
+#define SD_MERGE_CUDA(call)        \
+    do {                           \
+        if ((call) != cudaSuccess) \
+            return false;          \
+    } while (0)
+#define SD_MERGE_BLAS(call)                  \
+    do {                                     \
+        if ((call) != CUBLAS_STATUS_SUCCESS) \
+            return false;                    \
+    } while (0)
+
+struct MergeLayout {
+    size_t q = 0, scales = 0, base = 0, diff = 0, up = 0, down = 0, bytes = 0;
+};
+static MergeLayout merge_layout(int width, int rows, int count, const SdInt8LoraPatch* patches, bool device_q) {
+    MergeLayout layout;
+    if (width < 256 || width > 24576 || width % 256 || rows <= 0 || count <= 0 || !patches)
+        return layout;
+    const auto aligned = [](size_t n) { return (n + 255) & ~size_t(255); };
+    for (int j = 0; j < count; ++j) {
+        const auto& p = patches[j];
+        if (p.rank <= 0 || p.rank > 256 || p.rows <= 0 || p.row_offset < 0 ||
+            int64_t(p.row_offset) + p.rows > rows || !std::isfinite(p.strength) || !p.up || !p.down)
+            return {};
+        layout.diff = std::max(layout.diff, aligned(size_t(p.rows) * width * sizeof(float)));
+        layout.up   = std::max(layout.up, aligned(size_t(p.rows) * p.rank * sizeof(float)));
+        layout.down = std::max(layout.down, aligned(size_t(p.rank) * width * sizeof(float)));
+    }
+    const size_t elements = size_t(rows) * width;
+    layout.q              = device_q ? 0 : aligned(elements);
+    layout.scales         = aligned(size_t(rows) * sizeof(float));
+    layout.base           = aligned(elements * sizeof(half));
+    layout.bytes          = layout.q + layout.scales + layout.base + layout.diff + layout.up + layout.down;
+    return layout;
+}
+
+extern "C" size_t sd_lora_int8_merge_workspace_bytes(int width, int rows, int count, const SdInt8LoraPatch* patches, bool device_q) {
+    return merge_layout(width, rows, count, patches, device_q).bytes;
+}
+
+extern "C" bool sd_lora_int8_merge_cuda(int width, int rows, int group, uint64_t seed, int count, const SdInt8LoraPatch* patches, int8_t* q, float* scales, bool device_q) {
+    const auto layout = merge_layout(width, rows, count, patches, device_q);
+    if (group != 256 || !layout.bytes || !q || !scales)
+        return false;
+    int devices = 0;
+    SD_MERGE_CUDA(cudaGetDeviceCount(&devices));
+    if (devices != 1)
+        return false;
+    SD_MERGE_CUDA(cudaSetDevice(0));
+    MergeCudaWorkspace ws;
+    SD_MERGE_CUDA(cudaStreamCreateWithFlags(&ws.stream, cudaStreamNonBlocking));
+    SD_MERGE_CUDA(cudaMalloc(&ws.memory, layout.bytes));
+    SD_MERGE_BLAS(cublasCreate(&ws.handle));
+    SD_MERGE_BLAS(cublasSetStream(ws.handle, ws.stream));
+    SD_MERGE_BLAS(cublasSetMathMode(ws.handle, CUBLAS_PEDANTIC_MATH));
+    char* mem  = static_cast<char*>(ws.memory);
+    int8_t* dq = device_q ? q : reinterpret_cast<int8_t*>(mem);
+    mem += layout.q;
+    float* ds = reinterpret_cast<float*>(mem);
+    mem += layout.scales;
+    half* base = reinterpret_cast<half*>(mem);
+    mem += layout.base;
+    float* diff = reinterpret_cast<float*>(mem);
+    mem += layout.diff;
+    float* up = reinterpret_cast<float*>(mem);
+    mem += layout.up;
+    float* down           = reinterpret_cast<float*>(mem);
+    const size_t elements = size_t(rows) * width;
+    if (!device_q)
+        SD_MERGE_CUDA(cudaMemcpyAsync(dq, q, elements, cudaMemcpyHostToDevice, ws.stream));
+    SD_MERGE_CUDA(cudaMemcpyAsync(ds, scales, size_t(rows) * sizeof(float), cudaMemcpyHostToDevice, ws.stream));
+    lora_merge_unrotate<<<dim3(rows, width / group), group, 0, ws.stream>>>(dq, ds, base, width, group);
+    for (int j = 0; j < count; ++j) {
+        const auto& p = patches[j];
+        SD_MERGE_CUDA(cudaMemcpyAsync(up, p.up, size_t(p.rows) * p.rank * sizeof(float), cudaMemcpyHostToDevice, ws.stream));
+        SD_MERGE_CUDA(cudaMemcpyAsync(down, p.down, size_t(p.rank) * width * sizeof(float), cudaMemcpyHostToDevice, ws.stream));
+        const float alpha = 1.f, beta = 0.f;
+        SD_MERGE_BLAS(cublasSgemm(ws.handle, CUBLAS_OP_N, CUBLAS_OP_N, width, p.rows, p.rank, &alpha, down, width, up, p.rank, &beta, diff, width));
+        lora_merge_add<<<(size_t(p.rows) * width + 255) / 256, 256, 0, ws.stream>>>(base + size_t(p.row_offset) * width, diff, p.strength, size_t(p.rows) * width);
+    }
+    const size_t shared_bytes = size_t(width + 256) * sizeof(float);
+    SD_MERGE_CUDA(cudaFuncSetAttribute(lora_merge_quantize, cudaFuncAttributeMaxDynamicSharedMemorySize, int(shared_bytes)));
+    lora_merge_quantize<<<rows, 256, shared_bytes, ws.stream>>>(base, dq, ds, width, seed);
+    SD_MERGE_CUDA(cudaGetLastError());
+    if (!device_q)
+        SD_MERGE_CUDA(cudaMemcpyAsync(q, dq, elements, cudaMemcpyDeviceToHost, ws.stream));
+    SD_MERGE_CUDA(cudaMemcpyAsync(scales, ds, size_t(rows) * sizeof(float), cudaMemcpyDeviceToHost, ws.stream));
+    SD_MERGE_CUDA(cudaStreamSynchronize(ws.stream));
+    return true;
+}
