+#ifndef SD_LORA_INT8_MERGE_H
+#define SD_LORA_INT8_MERGE_H
+#include <cstddef>
+#include <cstdint>
+
+// Host-resident, row-major matrices. Applies ordered patches before one requantization.
+struct SdInt8LoraPatch {
+    int row_offset;
+    int rows;
+    int rank;
+    float strength;
+    const float* up;
+    const float* down;
+};
+
+// Full-matrix CUDA scratch size, excluding the cuBLAS handle workspace.
+extern "C" size_t sd_lora_int8_merge_workspace_bytes(int input, int rows, int patch_count, const SdInt8LoraPatch* patches, bool device_quantized);
+
+// Scales/patches reside on the host; quantized may already reside on the CUDA device.
+// Caller owns reservation, original-weight restoration and configuration lifetime.
+extern "C" bool sd_lora_int8_merge_cuda(int input, int rows, int group_size, uint64_t seed, int patch_count, const SdInt8LoraPatch* patches, int8_t* quantized, float* scales, bool device_quantized = false);
+#endif
