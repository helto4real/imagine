+bool ModelManager::apply_merged_int8_loras(const std::vector<TensorState*>& states) {
+#ifndef SD_USE_CUDA
+    LOG_ERROR("INT8 LoRA merge requires CUDA");
+    return false;
+#else
+    std::vector<TensorState*> pending;
+    std::vector<ggml_tensor*> protected_tensors;
+    for (TensorState* state : states) {
+        if (!state || state->component == ModelComponent::LoRA || should_ignore(*state))
+            continue;
+        protected_tensors.push_back(state->tensor);
+        if (state->applied_lora_epoch != current_lora_epoch_)
+            pending.push_back(state);
+    }
+    if (pending.empty())
+        return true;
+    auto backend = pending.front()->compute_backend;
+    if (!sd_backend_is(backend, "CUDA"))
+        return false;
+    DeviceMemoryRequest request;
+    request.compute_backend = backend;
+    request.owner_id        = reinterpret_cast<uintptr_t>(this);
+
+    const auto names = tensor_names();
+    std::map<std::string, TensorState*> by_name;
+    for (const auto& state : tensor_states_)
+        by_name[state->name] = state.get();
+    auto borrowed = std::shared_ptr<ModelManager>(this, [](ModelManager*) {});
+    std::vector<std::shared_ptr<LoraModel>> adapters;
+    for (const auto& spec : loras_) {
+        auto adapter               = std::make_shared<LoraModel>(lora_id(spec), backend, pending.front()->params_backend,
+                                                                 borrowed, spec.file_id, lora_version_, pending.front()->residency_mode);
+        LoraModel::filter_t filter = nullptr;
+        if (!spec.tensor_name_prefix_filter.empty())
+            filter = [&](const std::string& n) { return starts_with(n, spec.tensor_name_prefix_filter); };
+        if (!adapter->init_params(n_threads_, filter))
+            return false;
+        adapter->multiplier = spec.multiplier;
+        adapter->preprocess_lora_tensors(names);
+        // This candidate deliberately rejects adapters outside its tested contract.
+        // Never disable the runtime branch and silently drop an unsupported patch.
+        for (const auto& entry : adapter->lora_tensors) {
+            std::string key              = entry.first;
+            const std::string suffixes[] = {".lora_up", ".lora_down", ".alpha", ".scale"};
+            bool recognized              = false;
+            for (const auto& suffix : suffixes) {
+                if (ends_with(key, suffix)) {
+                    key.resize(key.size() - suffix.size());
+                    recognized = true;
+                    break;
+                }
+            }
+            if (!recognized || !starts_with(key, "lora."))
+                return false;
+            key = key.substr(5);
+            if (ends_with(key, ".weight.1"))
+                key.resize(key.size() - 2);
+            auto found = by_name.find(key);
+            if (found == by_name.end() || found->second->tensor->type != GGML_TYPE_I8 ||
+                found->second->sources.empty() || !found->second->sources.front().is_int8_tensorwise ||
+                !found->second->sources.front().int8_convrot) {
+                LOG_ERROR("INT8 LoRA merge supports ordinary ConvRot linear adapters only");
+                return false;
+            }
+        }
+        adapters.push_back(std::move(adapter));
+    }
+
+    // Scale and weight residency can change independently. Restore the prepared
+    // scale when only that tensor was evicted, without patching a weight twice.
+    for (TensorState* state : pending) {
+        if (!ends_with(state->name, ".weight_scale"))
+            continue;
+        std::string weight_name = state->name.substr(0, state->name.size() - 6);
+        auto cached = merged_int8_scales_.find(weight_name), unused = merged_int8_scales_.end();
+        auto weight = by_name.find(weight_name);
+        if (cached != unused && weight != by_name.end() && weight->second->applied_lora_epoch == current_lora_epoch_) {
+            ggml_backend_tensor_set(state->tensor, cached->second.data(), 0, cached->second.size() * sizeof(float));
+        }
+    }
+    struct OwnedPatch {
+        SdInt8LoraPatch patch;
+        std::vector<float> up, down;
+    };
+    for (TensorState* state : pending) {
+        if (state->tensor->type != GGML_TYPE_I8 || !ends_with(state->name, ".weight"))
+            continue;
+        const int width = int(state->tensor->ne[0]), rows = int(state->tensor->ne[1]);
+        const bool gate_up = ends_with(state->name, ".img_mlp.gate_up.weight");
+        std::vector<OwnedPatch> owned;
+        for (const auto& adapter : adapters) {
+            for (int part = 0; part < (gate_up ? 2 : 1); ++part) {
+                const std::string prefix = "lora." + state->name + (part ? ".1" : "");
+                auto up = adapter->lora_tensors.find(prefix + ".lora_up"), down = adapter->lora_tensors.find(prefix + ".lora_down");
+                if (up == adapter->lora_tensors.end() && down == adapter->lora_tensors.end())
+                    continue;
+                if (up == adapter->lora_tensors.end() || down == adapter->lora_tensors.end())
+                    return false;
+                int rank = int(down->second->ne[1]), out = int(up->second->ne[1]);
+                const bool full_weight = part == 0 && out == rows;
+                const bool half_weight = gate_up && rows % 2 == 0 && out == rows / 2;
+                if (ggml_n_dims(up->second) > 2 || ggml_n_dims(down->second) > 2 || rank < 1 || rank > 256 ||
+                    down->second->ne[0] != width || up->second->ne[0] != rank || (!full_weight && !half_weight))
+                    return false;
+                double strength = adapter->multiplier;
+                auto scale = adapter->lora_tensors.find(prefix + ".scale"), alpha = adapter->lora_tensors.find(prefix + ".alpha");
+                if (scale != adapter->lora_tensors.end())
+                    strength *= adapter->scalar_value(scale->second);
+                else if (alpha != adapter->lora_tensors.end())
+                    strength *= double(adapter->scalar_value(alpha->second)) / rank;
+                OwnedPatch item;
+                item.patch = {part * out, out, rank, float(strength), nullptr, nullptr};
+                if (!adapter->load_merge_operand(up->second, item.up) || !adapter->load_merge_operand(down->second, item.down))
+                    return false;
+                owned.push_back(std::move(item));
+            }
+        }
+        if (owned.empty())
+            continue;
+        if (state->sources.empty())
+            return false;
+        const int group  = state->sources.front().int8_convrot_group_size;
+        auto scale_state = by_name.find(state->name + "_scale");
+        if (scale_state == by_name.end())
+            return false;
+        ggml_tensor* scale = scale_state->second->tensor;
+        if (scale->type != GGML_TYPE_F32 || ggml_nelements(scale) != rows || !scale->data || !state->tensor->data ||
+            std::find(states.begin(), states.end(), scale_state->second) == states.end())
+            return false;
+        std::vector<SdInt8LoraPatch> patches;
+        for (auto& item : owned) {
+            item.patch.up   = item.up.data();
+            item.patch.down = item.down.data();
+            patches.push_back(item.patch);
+        }
+        const bool device_quantized = state->tensor->buffer && !ggml_backend_buffer_is_host(state->tensor->buffer);
+        const size_t workspace = sd_lora_int8_merge_workspace_bytes(width, rows, int(patches.size()), patches.data(), device_quantized);
+        if (!workspace)
+            return false;
+        // Reserve full-matrix scratch plus headroom for the cuBLAS handle. The
+        // existing capacity check adds its own safety margin and can evict other weights.
+        request.pending_allocation_bytes = workspace + 32ULL * 1024 * 1024;
+        if (!ensure_compute_backend_capacity(request, protected_tensors, {}, protected_tensors))
+            return false;
+        std::vector<float> scales(rows);
+        ggml_backend_synchronize(backend);
+        // Always pair reloaded original INT8 bytes with original scales, even
+        // when a previously merged scale tensor is still resident.
+        auto cpu_ctx = std::unique_ptr<ggml_context, decltype(&ggml_free)>(
+            ggml_init({(scale_state->second->sources.size() + 1) * ggml_tensor_overhead(), nullptr, true}), ggml_free);
+        if (!cpu_ctx)
+            return false;
+        std::map<std::string, ggml_tensor*> parts;
+        std::set<std::string> selected;
+        size_t offset = 0;
+        for (const auto& source : scale_state->second->sources) {
+            auto* part = ggml_new_tensor(cpu_ctx.get(), GGML_TYPE_F32, source.n_dims, source.ne);
+            if (offset + ggml_nelements(part) > scales.size())
+                return false;
+            part->data = scales.data() + offset;
+            offset += ggml_nelements(part);
+            parts[source.name] = part;
+            selected.insert(source.name);
+        }
+        if (offset != scales.size())
+            return false;
+        auto load_scale = [&](const TensorStorage& source, ggml_tensor** dst) {
+            auto found = parts.find(source.name);
+            *dst       = found == parts.end() ? nullptr : found->second;
+            return true;
+        };
+        if (!model_loader_.load_tensors(load_scale, enable_mmap_, &selected, false))
+            return false;
+        // Comfy's ordinary ModelPatcher seeds the quantizer from the full key.
+        const std::string key = starts_with(state->name, "model.") ? state->name.substr(6) : state->name;
+        uint32_t crc          = 0xffffffffu;
+        for (unsigned char ch : key) {
+            crc ^= ch;
+            for (int bit = 0; bit < 8; ++bit)
+                crc = (crc >> 1) ^ ((crc & 1) ? 0xedb88320u : 0u);
+        }
+        if (!sd_lora_int8_merge_cuda(width, rows, group, crc ^ 0xffffffffu, int(patches.size()), patches.data(), static_cast<int8_t*>(state->tensor->data), scales.data(), device_quantized))
+            return false;
+        ggml_backend_tensor_set(scale, scales.data(), 0, scales.size() * sizeof(float));
+        merged_int8_scales_[state->name] = std::move(scales);
+    }
+    for (TensorState* state : pending)
+        state->applied_lora_epoch = current_lora_epoch_;
+    return true;
+#endif
+}
