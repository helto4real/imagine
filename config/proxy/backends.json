    {
      "id": "koboldcpp",
      "label": "KoboldCpp",
      "adapter": "koboldcpp",
      "origin": "http://127.0.0.1:5001",
      "requires": ["~/git/cobolcpp/koboldcpp-linux-x64"],
      "launch": {
        "dir": "~/git/cobolcpp",
        "command": ["./koboldcpp-linux-x64"],
        "match": "koboldcpp-linux-x64"
      }
    },
    {
      "id": "tabbyapi",
      "label": "TabbyAPI",
